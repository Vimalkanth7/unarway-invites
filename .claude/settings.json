{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Bash(cat ./.env*)",
      "Bash(less ./.env*)",
      "Bash(more ./.env*)",
      "Bash(head ./.env*)",
      "Bash(tail ./.env*)",
      "Bash(nl ./.env*)",
      "PowerShell(Get-Content ./.env*)",
      "PowerShell(Get-Content -Path ./.env*)",
      "PowerShell(gc ./.env*)",
      "PowerShell(cat ./.env*)",
      "PowerShell(type ./.env*)"
    ]
  }
}
