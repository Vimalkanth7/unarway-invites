# Copy to .env.local and fill in real values. Never commit the filled-in file.

# Public site URL (used for absolute links, OG tags, Razorpay callback URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (test mode keys until Phase 6 is proven, then live keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
